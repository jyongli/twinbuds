<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Body" android:text="@string/brand" android:textSize="12sp"
            android:letterSpacing="0.16" android:textColor="@color/green" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/badge" android:textSize="11sp"
            android:background="@drawable/chip" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:textColor="@color/green" />
        <TextView style="@style/Body" android:layout_marginTop="14dp" android:text="@string/hero_title"
            android:textSize="38sp" android:textColor="@color/ink" android:textStyle="bold" android:lineSpacingExtra="0dp" />
        <TextView style="@style/Body" android:layout_marginTop="10dp" android:text="@string/hero_subtitle" />
        <com.jy.twinbuds.ui.HeadphonesView android:layout_width="match_parent" android:layout_height="140dp"
            android:importantForAccessibility="no" android:layout_marginTop="8dp" />
        <TextView style="@style/Body" android:text="@string/system_note" android:textSize="12sp"
            android:layout_marginBottom="22dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/devices_title" />
                <Button android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:minWidth="52dp" android:padding="0dp" android:text="@string/refresh" android:textColor="@color/green"
                    android:textSize="13sp" style="?android:attr/borderlessButtonStyle" />
            </LinearLayout>
            <TextView android:id="@+id/status_title" style="@style/Body" android:layout_marginTop="12dp"
                android:text="@string/device_placeholder" android:textColor="@color/ink" android:textStyle="bold" android:textSize="17sp" />
            <TextView android:id="@+id/status_detail" style="@style/Body" android:layout_marginTop="7dp" />
            <LinearLayout android:id="@+id/device_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="14dp" />
            <Button android:id="@+id/connect" style="@style/PrimaryButton" android:layout_marginTop="16dp" android:text="@string/permission_button" />
            <TextView style="@style/Body" android:text="@string/permission_explanation" android:layout_marginTop="10dp" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:orientation="vertical" android:background="@drawable/card" android:padding="20dp">
            <TextView style="@style/CardTitle" android:text="@string/guide_title" />
            <TextView android:id="@+id/guide_summary" style="@style/Body" android:layout_marginTop="12dp" android:text="@string/general_summary" />
            <Button android:id="@+id/guide" style="@style/SecondaryButton" android:layout_marginTop="16dp" android:text="@string/more_guide" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:orientation="vertical" android:background="@drawable/card" android:padding="20dp">
            <TextView style="@style/CardTitle" android:text="@string/test_title" />
            <TextView style="@style/Body" android:text="@string/test_description" android:layout_marginTop="12dp" />
            <TextView style="@style/Body" android:text="@string/feedback_description" android:layout_marginTop="8dp" android:textSize="12sp" />
            <Button android:id="@+id/play" style="@style/PrimaryButton" android:layout_marginTop="16dp" android:text="@string/play_test" android:enabled="false" android:alpha="0.45" />
            <TextView android:id="@+id/test_result" style="@style/Body" android:text="@string/pending_test" android:layout_marginTop="14dp" />
            <TextView android:id="@+id/route_detail" style="@style/Body" android:layout_marginTop="8dp" android:textSize="11sp" android:visibility="gone" />
        </LinearLayout>
        <Button android:id="@+id/report" style="@style/SecondaryButton" android:layout_marginTop="20dp" android:text="@string/report_button" />
        <TextView style="@style/Body" android:text="@string/privacy_footer" android:textSize="11sp" android:gravity="center"
            android:layout_marginTop="20dp" android:layout_marginBottom="8dp" />
    </LinearLayout>
</ScrollView>
